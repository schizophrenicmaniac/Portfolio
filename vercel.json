{
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/medium-feed", "destination": "https://medium.com/feed/@divyanshyadav1027" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
